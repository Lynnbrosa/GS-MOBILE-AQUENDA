# Endereço das duas APIs do Aquenda. Sem estas variáveis o app tenta sozinho:
# emulador Android -> 10.0.2.2, celular físico -> o IP do computador que roda o Metro.
# Copie para .env e ajuste se precisar (o .env não vai para o repositório).
EXPO_PUBLIC_API_CSHARP_URL=http://10.0.2.2:5000
EXPO_PUBLIC_API_SOA_URL=http://10.0.2.2:8000
